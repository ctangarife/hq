# ==============================================================================
# HQ - AI Agent Headquarters
# Template de variables de entorno
# Copia este archivo a .env y completa los valores
# ==============================================================================

# -----------------------------------------------------------------------------
# INFRAESTRUCTURA
# -----------------------------------------------------------------------------

# Puerto donde Nginx escucha (host)
# 8093 por politica del SO (el 80 esta reservado). Es el UNICO puerto de entrada.
NGINX_HOST_PORT=8093

# Puerto healthcheck de Nginx
NGINX_HEALTH_PORT=8080

# -----------------------------------------------------------------------------
# MONGODB
# -----------------------------------------------------------------------------

# Usuario root de MongoDB
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=change_me_please_use_strong_password

# Base de datos de la aplicación
MONGODB_DATABASE=hq

# -----------------------------------------------------------------------------
# API BACKEND (Node.js/Express)
# -----------------------------------------------------------------------------

# Puerto interno del API (NO se expone al host; solo alcanza por Nginx)
API_PORT=3001

# URL pública del API (a traves de Nginx, unico puerto de entrada)
API_PUBLIC_URL=http://localhost:8093/api

# Secret para autenticación (mínimo 32 caracteres)
API_JWT_SECRET=change_me_to_a_secure_random_string_min_32_chars

# Secret para autenticación de UI (similar a openclaw-docker)
UI_SECRET=change_me_to_a_secure_password

# -----------------------------------------------------------------------------
# FRONTEND (Next.js)
# -----------------------------------------------------------------------------

# Puerto interno del frontend
NEXT_PORT=3000

# URL pública del frontend (a traves de Nginx)
NEXT_PUBLIC_URL=http://localhost:8093

# URL del API backend (a traves de Nginx)
NEXT_PUBLIC_API_URL=http://localhost:8093/api

# -----------------------------------------------------------------------------
# DOCKER ENGINE API
# -----------------------------------------------------------------------------

# Socket de Docker para gestión de contenedores
# - Linux: /var/run/docker.sock
# - Windows/Docker Desktop: //./pipe/docker_engine
# - macOS: /var/run/docker.sock
DOCKER_SOCKET=/var/run/docker.sock

# -----------------------------------------------------------------------------
# AGENT BASE (OpenClaw)
# -----------------------------------------------------------------------------

# Imagen base para agentes (Docker Hub o build local)
AGENT_BASE_IMAGE=openclaw/agent:latest

# Red Docker donde se crean los contenedores de agentes
AGENT_NETWORK=hq-network

# Directorio de workspace compartido para agentes
AGENT_WORKSPACE_PATH=/data/agent-workspace

# Directorio para archivos de misiones (inputs, outputs, artifacts)
HQ_FILES_PATH=/data/hq-files

# -----------------------------------------------------------------------------
# TELEGRAM BOT
# -----------------------------------------------------------------------------

# Token del bot de Telegram (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=

# Webhook URL para Telegram (se configura automáticamente)
TELEGRAM_WEBHOOK_URL=http://localhost:8093/api/telegram/webhook

# Chat ID donde se envían notificaciones globales
TELEGRAM_NOTIFICATION_CHAT_ID=

# -----------------------------------------------------------------------------
# LLM PROVIDERS - vía LiteLLM proxy centralizado
# -----------------------------------------------------------------------------
# HQ centraliza TODOS los LLM calls a través de litellm.ctangarife.com.
# La virtual key global de HQ se crea en LiteLLM (POST /key/generate con master
# key). Para gestión por workspace/usuario en el futuro, ver LitellmService.
#
# Ver nota del vault: "LiteLLM Centralizado" + "VPS LiteLLM"

# URL del proxy LiteLLM (sin sufijo /v1)
LITELLM_API_URL=https://litellm.ctangarife.com

# Virtual key global de HQ (crear con: POST /key/generate + master key)
LITELLM_VIRTUAL_KEY=

# Master key del proxy (solo para crear/rotar virtual keys)
LITELLM_MASTER_KEY=

# Provider y modelo por defecto (resueltos por el proxy)
DEFAULT_LLM_PROVIDER=litellm
DEFAULT_LLM_MODEL=glm-4.7

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Nivel de logging: debug, info, warn, error
LOG_LEVEL=info

# Habilitar logs en consola
LOG_CONSOLE=true

# -----------------------------------------------------------------------------
# SEGURIDAD
# -----------------------------------------------------------------------------

# Permitir auth inseguro (solo para desarrollo)
ALLOW_INSECURE_AUTH=true

# CORS origins permitidos (separados por coma) - un solo origen ahora, via Nginx
CORS_ORIGINS=http://localhost:8093

# -----------------------------------------------------------------------------
# MONITOREO
# -----------------------------------------------------------------------------

# Habilitar endpoint de métricas
METRICS_ENABLED=false

# Puerto para métricas (Prometheus)
METRICS_PORT=9090
